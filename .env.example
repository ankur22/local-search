# local-search agent configuration. Copy to .env and fill in real values.
# Load into the shell with:  set -a; . ./.env; set +a
# .env is gitignored — never commit real keys.

# --- Chat provider / model -------------------------------------------------
# The chat model is called over the OpenAI-compatible /v1/chat/completions API,
# so Ollama, OpenAI and Anthropic share one code path.
RAG_CHAT_PROVIDER=ollama          # ollama | openai | anthropic
RAG_CHAT_MODEL=llama3.1           # ollama: llama3.1 / qwen3-coder:30b
                                  # openai: gpt-4o / gpt-4o-mini
                                  # anthropic: claude-haiku-4-5 / claude-sonnet-4-5

# API key for the selected provider (only the matching one is needed):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional endpoint overrides (defaults shown):
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1

# Reasoning models (e.g. GPT-5) only accept the default temperature, so set:
# RAG_CHAT_TEMPERATURE=none          # 'none' omits temperature; or set a number
# RAG_CHAT_REASONING_EFFORT=high     # minimal|low|medium|high (also omits temperature)
# Note: gpt-5.5 does NOT allow tools + reasoning_effort on /v1/chat/completions,
# so for the tool-calling agent use RAG_CHAT_TEMPERATURE=none without reasoning_effort.

# --- Ollama (chat default + embeddings) ------------------------------------
OLLAMA_URL=http://localhost:11434
RAG_EMBED_MODEL=mxbai-embed-large   # embeddings always use Ollama

# --- RAG index -------------------------------------------------------------
RAG_DB_DIR=./demo_chroma
RAG_COLLECTION=demo_corpus

# --- Sigil (AI observability) export + guardrail ---------------------------
SIGIL_GENERATION_EXPORT_ENDPOINT=http://localhost:8090/api/v1/generations:export
SIGIL_API_ENDPOINT=http://localhost:8090
SIGIL_HOOKS_ENABLED=1
MCP_URL=http://127.0.0.1:8200/mcp
